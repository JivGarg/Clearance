# Copy to .env (repo root) and fill in. One file is shared by the frontend and the backend:
#   - frontend/next.config.ts loads it, so NEXT_PUBLIC_* values reach the browser bundle
#   - backend/app/config.py loads it
# .env is git-ignored. Never commit real keys.

# ---- Supabase (Project Settings > API) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_, never send
# to the browser, never log it. Used by the backend to write check results.
SUPABASE_SERVICE_ROLE_KEY=
# Used by the backend to verify the signed-in user's JWT (Project Settings > API > JWT secret).
SUPABASE_JWT_SECRET=

# ---- Backend ---------------------------------------------------------------------------
# Origin allowed by the backend's CORS policy.
FRONTEND_ORIGIN=http://localhost:3000
# Where the frontend finds the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- AI provider ------------------------------------------------------------------------
# SERVER-SIDE ONLY (backend). Not used yet: Phase 1 checks are mocked. Keep out of the browser.
GEMINI_API_KEY=

# ---- Demo auth (Phase 1 scaffold only) -------------------------------------------------
# The app currently signs in with a cookie holding one of five seeded user ids. That is NOT
# secure (the cookie can be forged), so in production builds it is refused unless you set
# this to "true" on purpose, e.g. for a controlled demo. Remove once Supabase Auth is wired.
ALLOW_DEMO_AUTH=
